<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════
     res/values/styles.xml
     ════════════════════════════════════════════════════ -->
<resources>

    <!-- ── Button Styles ───────────────────────────── -->

    <style name="Widget.Kittys.Button.Gradient" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:background">@drawable/bg_gradient_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Kittys.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="strokeColor">@color/blue_primary</item>
        <item name="android:textColor">@color/blue_primary</item>
        <item name="android:background">@drawable/bg_neu_surface</item>
    </style>

    <!-- ── Text Styles ──────────────────────────────── -->

    <style name="TextAppearance.Kittys.Display" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <style name="TextAppearance.Kittys.Headline" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Kittys.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Kittys.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Kittys.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Kittys.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- ── Card Styles ──────────────────────────────── -->

    <style name="Widget.Kittys.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardBackgroundColor">@color/neu_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="android:padding">@dimen/space_xl</item>
    </style>

    <style name="Widget.Kittys.Card.Small" parent="Widget.Kittys.Card">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <!-- ── Input Styles ─────────────────────────────── -->

    <style name="Widget.Kittys.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="hintTextColor">@color/text_muted</item>
    </style>

    <!-- ── Bottom Sheet ─────────────────────────────── -->

    <style name="Widget.Kittys.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Kittys.BottomSheet</item>
        <item name="android:background">@color/neu_surface</item>
    </style>

    <style name="ShapeAppearance.Kittys.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ── Chip Style ───────────────────────────────── -->

    <style name="Widget.Kittys.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="chipCornerRadius">50dp</item>
        <item name="chipBackgroundColor">@drawable/selector_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.Kittys.Label</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <!-- ── Dialog Style ─────────────────────────────── -->

    <style name="Widget.Kittys.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:background">@color/neu_surface</item>
        <item name="dialogCornerRadius">@dimen/radius_xl</item>
        <item name="android:windowAnimationStyle">@style/Animation.Kittys.Dialog</item>
    </style>

    <style name="Animation.Kittys.Dialog" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/scale_up</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

</resources>
