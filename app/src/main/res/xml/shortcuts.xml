        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.kittys.premium"
            android:targetClass="com.kittys.premium.MainActivity"
            android:data="kittys://ai" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_logo"
        android:shortcutShortLabel="@string/nav_explore"
        android:shortcutLongLabel="@string/browse_categories">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.kittys.premium"
