<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- DM Sans — body text, labels, UI copy -->
    <font
        android:font="@font/dm_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/dm_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/dm_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/dm_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <!-- Outfit — headlines, display text, brand name -->
    <font
        android:font="@font/outfit_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/outfit_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/outfit_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/outfit_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/outfit_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/outfit_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        android:font="@font/outfit_bold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/outfit_bold"
        app:fontStyle="normal"
        app:fontWeight="800" />

</font-family>